generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AutomationExecutionLog {
  id             String                 @id
  event_name     String
  reference_id   String
  action_taken   String
  status         AutomationStatus
  error_message  String?
  started_at     DateTime
  finished_at    DateTime
  duration_ms    Int
  hostname       String
  retry_number   Int                    @default(0)
  worker_id      String
  correlation_id String?
  failure_class  FailureClassification?

  @@index([correlation_id])
  @@index([event_name, reference_id])
  @@index([status])
  @@index([worker_id])
}

model AutomationMetric {
  id         String   @id
  metric_key String   @unique
  value      Int      @default(0)
  updated_at DateTime
}

model Booking {
  id                         String             @id
  booking_id                 String             @unique
  lead_id                    String?            @unique
  customer_id                String
  city_id                    String
  service_id                 String
  pricing_rule_id            String?
  scheduled_date             DateTime
  slot                       String?
  customer_name              String?
  customer_phone             String
  customer_email             String?
  address_line_1             String
  address_line_2             String?
  area                       String?
  landmark                   String?
  city_name                  String
  postal_code                String
  state                      String
  country                    String             @default("India")
  latitude                   Float?
  longitude                  Float?
  service_name               String
  estimated_duration_minutes Int?
  base_price                 Decimal            @db.Decimal(10, 2)
  discount                   Decimal            @default(0) @db.Decimal(10, 2)
  tax                        Decimal            @default(0) @db.Decimal(10, 2)
  final_amount               Decimal            @db.Decimal(10, 2)
  pricing_snapshot_json      Json?
  pricing_rule_name          String?
  pricing_version            String?
  status                     BookingStatus      @default(Pending)
  notes                      String?
  special_instructions       String?
  cancel_reason              String?
  assigned_user_id           String?
  created_by                 String
  updated_by                 String?
  created_at                 DateTime           @default(now())
  updated_at                 DateTime
  confirmed_at               DateTime?
  scheduled_at               DateTime?
  assigned_at                DateTime?
  started_at                 DateTime?
  completed_at               DateTime?
  cancelled_at               DateTime?
  cgst_amount                Decimal            @default(0) @db.Decimal(10, 2)
  cgst_percent               Decimal            @default(0) @db.Decimal(5, 2)
  igst_amount                Decimal            @default(0) @db.Decimal(10, 2)
  igst_percent               Decimal            @default(0) @db.Decimal(5, 2)
  sgst_amount                Decimal            @default(0) @db.Decimal(10, 2)
  sgst_percent               Decimal            @default(0) @db.Decimal(5, 2)
  User                       User?              @relation(fields: [assigned_user_id], references: [id])
  City                       City               @relation(fields: [city_id], references: [id])
  Customer                   Customer           @relation(fields: [customer_id], references: [id])
  Lead                       Lead?              @relation(fields: [lead_id], references: [id])
  PricingRule                PricingRule?       @relation(fields: [pricing_rule_id], references: [id])
  Service                    Service            @relation(fields: [service_id], references: [id])
  BookingHistory             BookingHistory[]
  Complaint                  Complaint[]
  CustomerFeedback           CustomerFeedback[]
  Job                        Job?

  @@index([assigned_user_id])
  @@index([booking_id])
  @@index([city_id])
  @@index([created_at])
  @@index([customer_id])
  @@index([scheduled_date])
  @@index([service_id])
  @@index([status])
}

model BookingHistory {
  id          String         @id
  booking_id  String
  from_status BookingStatus?
  to_status   BookingStatus
  changed_by  String
  changed_at  DateTime       @default(now())
  Booking     Booking        @relation(fields: [booking_id], references: [id])
}

model BookingSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model ChecklistTemplate {
  id                    String                  @id
  name                  String
  description           String?
  service_id            String?
  is_active             Boolean                 @default(true)
  created_by            String
  created_at            DateTime                @default(now())
  updated_at            DateTime
  ChecklistTemplateItem ChecklistTemplateItem[]
  JobChecklist          JobChecklist[]

  @@index([service_id])
}

model ChecklistTemplateItem {
  id                String            @id
  template_id       String
  label             String
  sort_order        Int               @default(0)
  is_required       Boolean           @default(false)
  ChecklistTemplate ChecklistTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
}

model City {
  id          String        @id
  name        String        @unique
  is_active   Boolean       @default(true)
  state       String?
  Booking     Booking[]
  Lead        Lead[]
  PricingRule PricingRule[]
  ServiceArea ServiceArea[]
  User        User[]
}

model Complaint {
  id                String              @id
  complaint_id      String              @unique
  sequence_number   Int                 @unique
  customer_id       String
  booking_id        String?
  job_id            String?
  invoice_id        String?
  subject           String
  description       String
  status            ComplaintStatus     @default(Open)
  priority          ComplaintPriority   @default(Normal)
  assigned_to       String?
  resolution_note   String?
  created_by        String
  created_at        DateTime            @default(now())
  updated_at        DateTime
  User              User?               @relation(fields: [assigned_to], references: [id])
  Booking           Booking?            @relation(fields: [booking_id], references: [id])
  Customer          Customer            @relation(fields: [customer_id], references: [id])
  Invoice           Invoice?            @relation(fields: [invoice_id], references: [id])
  Job               Job?                @relation(fields: [job_id], references: [id])
  ComplaintNote     ComplaintNote[]
  ComplaintTimeline ComplaintTimeline[]

  @@index([assigned_to])
  @@index([booking_id])
  @@index([customer_id])
  @@index([job_id])
  @@index([status])
}

model ComplaintNote {
  id           String    @id
  complaint_id String
  note         String
  created_by   String
  created_at   DateTime  @default(now())
  Complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
  User         User      @relation(fields: [created_by], references: [id])

  @@index([complaint_id])
}

model ComplaintSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model ComplaintTimeline {
  id           String           @id
  complaint_id String
  from_status  ComplaintStatus?
  to_status    ComplaintStatus
  note         String?
  changed_by   String
  changed_at   DateTime         @default(now())
  User         User             @relation(fields: [changed_by], references: [id])
  Complaint    Complaint        @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
}

model Customer {
  id                 String             @id
  phone              String             @unique
  name               String?
  is_repeat_customer Boolean            @default(false)
  tags               String[]
  Booking            Booking[]
  Complaint          Complaint[]
  CustomerAddress    CustomerAddress[]
  CustomerFeedback   CustomerFeedback[]
  Lead               Lead[]
  Payment            Payment[]
  Quote              Quote[]
}

model CustomerAddress {
  id          String   @id
  customer_id String
  label       String
  address     String
  city        String?
  pincode     String?
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime
  Customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
}

model CustomerFeedback {
  id           String   @id
  customer_id  String
  booking_id   String?
  job_id       String?
  rating       Int
  comment      String?
  submitted_by String
  created_at   DateTime @default(now())
  Booking      Booking? @relation(fields: [booking_id], references: [id])
  Customer     Customer @relation(fields: [customer_id], references: [id])
  Job          Job?     @relation(fields: [job_id], references: [id])

  @@index([booking_id])
  @@index([customer_id])
  @@index([rating])
}

model Invoice {
  id                    String           @id
  invoice_number        String           @unique
  sequence_number       Int              @unique
  booking_id            String           @unique
  city_id               String
  technician_id         String?
  issue_date            DateTime
  due_date              DateTime
  customer_name         String?
  customer_phone        String
  billing_address       String
  service_name          String
  base_amount           Decimal          @db.Decimal(10, 2)
  discount_amount       Decimal          @default(0) @db.Decimal(10, 2)
  cgst_percent          Decimal          @default(0) @db.Decimal(5, 2)
  cgst_amount           Decimal          @default(0) @db.Decimal(10, 2)
  sgst_percent          Decimal          @default(0) @db.Decimal(5, 2)
  sgst_amount           Decimal          @default(0) @db.Decimal(10, 2)
  igst_percent          Decimal          @default(0) @db.Decimal(5, 2)
  igst_amount           Decimal          @default(0) @db.Decimal(10, 2)
  total_tax_amount      Decimal          @default(0) @db.Decimal(10, 2)
  final_amount          Decimal          @db.Decimal(10, 2)
  pricing_snapshot_json Json?
  status                InvoiceStatus    @default(Draft)
  payment_status        PaymentStatus    @default(Unpaid)
  amount_paid           Decimal          @default(0) @db.Decimal(10, 2)
  balance_due           Decimal          @db.Decimal(10, 2)
  created_by            String
  updated_by            String?
  created_at            DateTime         @default(now())
  updated_at            DateTime
  pdf_url               String?
  Complaint             Complaint[]
  InvoiceHistory        InvoiceHistory[]
  InvoiceItem           InvoiceItem[]
  Payment               Payment[]

  @@index([city_id])
  @@index([customer_phone])
  @@index([payment_status])
  @@index([status])
}

model InvoiceHistory {
  id              String         @id
  invoice_id      String
  action          String
  from_status     InvoiceStatus?
  to_status       InvoiceStatus
  changed_by      String
  changed_by_role String?
  reason          String?
  changed_at      DateTime       @default(now())
  Invoice         Invoice        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
}

model InvoiceItem {
  id              String  @id
  invoice_id      String
  service_name    String
  quantity        Int     @default(1)
  unit_price      Decimal @db.Decimal(10, 2)
  discount_amount Decimal @default(0) @db.Decimal(10, 2)
  cgst_amount     Decimal @default(0) @db.Decimal(10, 2)
  sgst_amount     Decimal @default(0) @db.Decimal(10, 2)
  igst_amount     Decimal @default(0) @db.Decimal(10, 2)
  line_total      Decimal @db.Decimal(10, 2)
  Invoice         Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model Job {
  id                         String                 @id
  job_id                     String                 @unique
  booking_id                 String                 @unique
  assigned_user_id           String?
  status                     JobStatus              @default(Pending)
  priority                   JobPriority            @default(Normal)
  scheduled_start            DateTime
  scheduled_end              DateTime?
  actual_start               DateTime?
  actual_end                 DateTime?
  estimated_duration_minutes Int?
  completion_notes           String?
  internal_notes             String?
  cancellation_reason        String?
  failure_reason             JobFailureReason?
  signature_url              String?
  signed_by_name             String?
  signed_at                  DateTime?
  latitude                   Float?
  longitude                  Float?
  created_by                 String
  updated_by                 String?
  created_at                 DateTime               @default(now())
  updated_at                 DateTime
  Complaint                  Complaint[]
  CustomerFeedback           CustomerFeedback[]
  User                       User?                  @relation(fields: [assigned_user_id], references: [id])
  Booking                    Booking                @relation(fields: [booking_id], references: [id])
  JobAssignmentHistory       JobAssignmentHistory[]
  JobHistory                 JobHistory[]
  JobMedia                   JobMedia[]

  @@index([assigned_user_id])
  @@index([job_id])
  @@index([scheduled_start])
  @@index([status])
}

model JobAssignmentHistory {
  id               String   @id
  job_id           String
  previous_user_id String?
  new_user_id      String?
  assigned_by      String
  assigned_at      DateTime @default(now())
  reason           String?
  Job              Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
}

model JobChecklist {
  id                String             @id
  job_id            String
  template_id       String
  applied_at        DateTime           @default(now())
  applied_by        String
  ChecklistTemplate ChecklistTemplate  @relation(fields: [template_id], references: [id])
  JobChecklistItem  JobChecklistItem[]

  @@unique([job_id, template_id])
  @@index([job_id])
}

model JobChecklistItem {
  id           String       @id
  checklist_id String
  label        String
  sort_order   Int          @default(0)
  is_required  Boolean      @default(false)
  is_checked   Boolean      @default(false)
  checked_by   String?
  checked_at   DateTime?
  notes        String?
  JobChecklist JobChecklist @relation(fields: [checklist_id], references: [id], onDelete: Cascade)

  @@index([checklist_id])
}

model JobHistory {
  id              String     @id
  job_id          String
  from_status     JobStatus?
  to_status       JobStatus
  changed_by      String
  changed_by_role String?
  ip_address      String?
  changed_at      DateTime   @default(now())
  note            String?
  Job             Job        @relation(fields: [job_id], references: [id], onDelete: Cascade)
}

model JobMedia {
  id          String        @id
  job_id      String
  type        MediaType     @default(Image)
  category    MediaCategory @default(Other)
  url         String
  uploaded_by String
  uploaded_at DateTime      @default(now())
  Job         Job           @relation(fields: [job_id], references: [id], onDelete: Cascade)
}

model JobSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model Lead {
  id             String        @id
  phone          String
  name           String?
  source         LeadSource
  status         LeadStatus    @default(New)
  city_id        String?
  service_id     String?
  assigned_to    String?
  lost_reason_id String?
  customer_id    String
  Booking        Booking?
  User           User?         @relation(fields: [assigned_to], references: [id])
  City           City?         @relation(fields: [city_id], references: [id])
  Customer       Customer      @relation(fields: [customer_id], references: [id])
  LostReason     LostReason?   @relation(fields: [lost_reason_id], references: [id])
  Service        Service?      @relation(fields: [service_id], references: [id])
  LeadHistory    LeadHistory[]
  LeadNote       LeadNote[]
  Quote          Quote[]
}

model LeadHistory {
  id         String      @id
  lead_id    String
  from_stage LeadStatus?
  to_stage   LeadStatus
  changed_by String
  changed_at DateTime    @default(now())
  User       User        @relation(fields: [changed_by], references: [id])
  Lead       Lead        @relation(fields: [lead_id], references: [id], onDelete: Cascade)
}

model LeadNote {
  id         String   @id
  lead_id    String
  note_text  String
  created_by String
  created_at DateTime @default(now())
  User       User     @relation(fields: [created_by], references: [id])
  Lead       Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
}

model LostReason {
  id          String @id
  reason_text String
  Lead        Lead[]
}

model NotificationQueue {
  id                  String              @id
  recipient_type      String
  recipient_id        String
  channel             NotificationChannel
  provider            String?
  provider_message_id String?
  template_code       String
  payload             Json
  error_message       String?
  created_at          DateTime            @default(now())
  sent_at             DateTime?
  attempts            Int                 @default(0)
  max_attempts        Int                 @default(3)
  status              NotificationStatus  @default(PENDING)
  correlation_id      String?
  payload_version     String              @default("1.0")

  @@index([correlation_id])
  @@index([recipient_id])
  @@index([status])
}

model Payment {
  id               String                   @id
  payment_number   String                   @unique
  sequence_number  Int                      @unique
  invoice_id       String
  customer_id      String
  amount           Decimal                  @db.Decimal(10, 2)
  payment_method   PaymentMethod
  payment_status   PaymentTransactionStatus @default(Pending)
  payment_date     DateTime                 @default(now())
  payment_metadata Json?
  notes            String?
  recorded_by      String
  created_at       DateTime                 @default(now())
  Customer         Customer                 @relation(fields: [customer_id], references: [id])
  Invoice          Invoice                  @relation(fields: [invoice_id], references: [id])
  User             User                     @relation(fields: [recorded_by], references: [id])
  PaymentHistory   PaymentHistory[]

  @@index([customer_id])
  @@index([invoice_id])
  @@index([payment_date])
  @@index([payment_status])
  @@index([recorded_by])
}

model PaymentHistory {
  id              String   @id
  payment_id      String
  action          String
  changed_by      String
  changed_by_role String?
  reason          String?
  ip_address      String?
  changed_at      DateTime @default(now())
  User            User     @relation(fields: [changed_by], references: [id])
  Payment         Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)
}

model PaymentSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model PricingRule {
  id           String    @id
  service_id   String
  city_id      String?
  bhk_type     String?
  tank_size    String?
  base_price   Float
  cgst_percent Float     @default(9)
  igst_percent Float     @default(0)
  sgst_percent Float     @default(9)
  Booking      Booking[]
  City         City?     @relation(fields: [city_id], references: [id])
  Service      Service   @relation(fields: [service_id], references: [id])

  @@unique([service_id, city_id, bhk_type, tank_size])
}

model Quote {
  id              String          @id
  quote_id        String          @unique
  sequence_number Int             @unique
  customer_id     String
  lead_id         String?
  subject         String
  description     String?
  status          QuoteStatus     @default(Draft)
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal         @default(0) @db.Decimal(12, 2)
  discount_amount Decimal         @default(0) @db.Decimal(12, 2)
  total_amount    Decimal         @default(0) @db.Decimal(12, 2)
  valid_until     DateTime?
  notes           String?
  terms           String?
  created_by      String
  created_at      DateTime        @default(now())
  updated_at      DateTime
  sent_at         DateTime?
  viewed_at       DateTime?
  accepted_at     DateTime?
  rejected_at     DateTime?
  Customer        Customer        @relation(fields: [customer_id], references: [id])
  Lead            Lead?           @relation(fields: [lead_id], references: [id])
  QuoteLineItem   QuoteLineItem[]
  QuoteTimeline   QuoteTimeline[]

  @@index([customer_id])
  @@index([lead_id])
  @@index([status])
  @@index([valid_until])
}

model QuoteLineItem {
  id          String  @id
  quote_id    String
  service_id  String?
  description String
  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(12, 2)
  tax_percent Decimal @default(18) @db.Decimal(5, 2)
  total_price Decimal @db.Decimal(12, 2)
  sort_order  Int     @default(0)
  Quote       Quote   @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([quote_id])
}

model QuoteSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model QuoteTimeline {
  id          String       @id
  quote_id    String
  from_status QuoteStatus?
  to_status   QuoteStatus
  note        String?
  changed_by  String
  changed_at  DateTime     @default(now())
  Quote       Quote        @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([quote_id])
}

model Role {
  id   String @id
  name String @unique
  User User[]
}

model ScheduledTask {
  id              String       @id
  task_name       String
  payload         Json?
  scheduled_for   DateTime
  priority        TaskPriority @default(NORMAL)
  locked_at       DateTime?
  locked_by       String?
  attempts        Int          @default(0)
  max_attempts    Int          @default(3)
  last_error      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime
  idempotency_key String       @unique
  correlation_id  String?
  metadata        Json

  @@index([correlation_id])
  @@index([locked_at])
  @@index([priority])
  @@index([scheduled_for])
  @@index([task_name])
}

model Service {
  id          String        @id
  name        String        @unique
  description String?
  base_price  Float
  is_active   Boolean       @default(true)
  Booking     Booking[]
  Lead        Lead[]
  PricingRule PricingRule[]
}

model ServiceArea {
  id             String  @id
  city_id        String
  name           String
  polygon_coords Json
  is_active      Boolean @default(true)
  City           City    @relation(fields: [city_id], references: [id])
}

model StaffAvailability {
  id              String   @id
  staff_id        String
  date            DateTime
  is_available    Boolean  @default(true)
  daily_job_limit Int?
  jobs_assigned   Int      @default(0)
  User            User     @relation(fields: [staff_id], references: [id])
}

model SystemSetting {
  key        String   @id
  value      String
  label      String?
  updated_by String?
  updated_at DateTime
}

model User {
  id                String              @id
  name              String
  phone             String              @unique
  password_hash     String
  role_id           String
  city_id           String?
  joining_date      DateTime?
  is_active         Boolean             @default(true)
  skill_tags        String[]
  Booking           Booking[]
  Complaint         Complaint[]
  ComplaintNote     ComplaintNote[]
  ComplaintTimeline ComplaintTimeline[]
  Job               Job[]
  Lead              Lead[]
  LeadHistory       LeadHistory[]
  LeadNote          LeadNote[]
  Payment           Payment[]
  PaymentHistory    PaymentHistory[]
  StaffAvailability StaffAvailability[]
  City              City?               @relation(fields: [city_id], references: [id])
  Role              Role                @relation(fields: [role_id], references: [id])
}

model WhatsAppMessage {
  id              String           @id
  thread_id       String
  direction       MessageDirection
  body            String
  status          MessageStatus    @default(SENT)
  meta_message_id String?
  sent_by         String?
  deleted_at      DateTime?
  created_at      DateTime         @default(now())
  WhatsAppThread  WhatsAppThread   @relation(fields: [thread_id], references: [id])

  @@index([meta_message_id])
  @@index([thread_id])
}

model WhatsAppThread {
  id              String            @id
  customer_phone  String
  customer_id     String?
  assigned_to     String?
  status          ThreadStatus      @default(OPEN)
  unread_count    Int               @default(0)
  last_message_at DateTime?
  created_at      DateTime          @default(now())
  updated_at      DateTime
  WhatsAppMessage WhatsAppMessage[]

  @@index([assigned_to])
  @@index([customer_id])
  @@index([customer_phone])
  @@index([last_message_at])
  @@index([status])
}

enum AutomationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BookingStatus {
  Draft
  Pending
  Confirmed
  Scheduled
  Assigned
  InProgress
  Completed
  Cancelled
  NoShow
}

enum ComplaintPriority {
  Low
  Normal
  High
  Critical
}

enum ComplaintStatus {
  Open
  Assigned
  InProgress
  Resolved
  Closed
  Escalated
}

enum FailureClassification {
  PERMANENT
  TRANSIENT
  VALIDATION
  PROVIDER
  INTERNAL
}

enum InvoiceStatus {
  Draft
  Issued
  Cancelled
}

enum JobFailureReason {
  NO_ACCESS
  CUSTOMER_ABSENT
  MATERIAL_MISSING
  WEATHER
  TECHNICAL_FAILURE
  OTHER
}

enum JobPriority {
  Low
  Normal
  High
  Urgent
}

enum JobStatus {
  Pending
  Assigned
  Accepted
  Travelling
  Arrived
  Started
  Completed
  Cancelled
  Failed
  NoAccess
  CustomerNotAvailable
  Rescheduled
}

enum LeadSource {
  Phone
  WhatsApp
  WebsiteForm
  MetaAds
  ManualEntry
  Justdial
  Referrals
}

enum LeadStatus {
  New
  Contacted
  FollowUp
  Qualified
  QuotationSent
  Booked
  Lost
}

enum MediaCategory {
  Before
  After
  Inspection
  Other
}

enum MediaType {
  Image
  Video
  Document
}

