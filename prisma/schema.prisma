generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

// Generic key-value store for global system configuration.
// Never store secrets here — only operational settings (e.g. registered state, GSTIN).
model SystemSetting {
  key        String   @id           // e.g. "company_registered_state"
  value      String                 // e.g. "Maharashtra"
  label      String?                // Human-readable label
  updated_by String?                // User ID who last updated
  updated_at DateTime @updatedAt
}


model City {
  id           String        @id @default(uuid())
  name         String        @unique
  state        String?
  is_active    Boolean       @default(true)
  users        User[]
  serviceAreas ServiceArea[]
  pricingRules PricingRule[]
  leads        Lead[]
  bookings     Booking[]
}

model ServiceArea {
  id             String  @id @default(uuid())
  city_id        String
  city           City    @relation(fields: [city_id], references: [id])
  name           String
  polygon_coords Json
  is_active      Boolean @default(true)
}

model User {
  id                String              @id @default(uuid())
  name              String
  phone             String              @unique
  password_hash     String
  role_id           String
  role              Role                @relation(fields: [role_id], references: [id])
  city_id           String?
  city              City?               @relation(fields: [city_id], references: [id])
  joining_date      DateTime?
  is_active         Boolean             @default(true)
  skill_tags        String[]
  staffAvailability StaffAvailability[]
  assignedLeads     Lead[]
  leadNotes         LeadNote[]
  leadHistory       LeadHistory[]
  assignedBookings  Booking[]           @relation("AssignedBookings")
  assignedJobs      Job[]               @relation("AssignedJobs")
  Payment           Payment[]
  PaymentHistory    PaymentHistory[]
  AssignedComplaints Complaint[] @relation("AssignedComplaints")
}

model StaffAvailability {
  id              String   @id @default(uuid())
  staff_id        String
  staff           User     @relation(fields: [staff_id], references: [id])
  date            DateTime
  is_available    Boolean  @default(true)
  daily_job_limit Int?
  jobs_assigned   Int      @default(0)
}

model Service {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  base_price   Float
  is_active    Boolean       @default(true)
  pricingRules PricingRule[]
  leads        Lead[]
  bookings     Booking[]
}

model PricingRule {
  id           String    @id @default(uuid())
  service_id   String
  service      Service   @relation(fields: [service_id], references: [id])
  city_id      String?
  city         City?     @relation(fields: [city_id], references: [id])
  bhk_type     String?
  tank_size    String?
  base_price   Float
  cgst_percent Float     @default(9)
  sgst_percent Float     @default(9)
  igst_percent Float     @default(0)
  bookings     Booking[]

  @@unique([service_id, city_id, bhk_type, tank_size])
}

enum LeadStatus {
  New
  Contacted
  FollowUp
  Qualified
  QuotationSent
  Booked
  Lost
}

enum LeadSource {
  Phone
  WhatsApp
  WebsiteForm
  MetaAds
  ManualEntry
  Justdial
  Referrals
}

model Lead {
  id             String      @id @default(uuid())
  phone          String
  name           String?
  source         LeadSource
  status         LeadStatus  @default(New)
  city_id        String?
  city           City?       @relation(fields: [city_id], references: [id])
  service_id     String?
  service        Service?    @relation(fields: [service_id], references: [id])
  assigned_to    String?
  assignedTo     User?       @relation(fields: [assigned_to], references: [id])
  lost_reason_id String?
  lostReason     LostReason? @relation(fields: [lost_reason_id], references: [id])
  customer_id    String
  customer       Customer    @relation(fields: [customer_id], references: [id])

  notes   LeadNote[]
  history LeadHistory[]
  booking Booking?
  quotes  Quote[]
}

model LeadNote {
  id         String   @id @default(uuid())
  lead_id    String
  lead       Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  note_text  String
  created_by String
  createdBy  User     @relation(fields: [created_by], references: [id])
  created_at DateTime @default(now())
}

model LeadHistory {
  id         String      @id @default(uuid())
  lead_id    String
  lead       Lead        @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  from_stage LeadStatus?
  to_stage   LeadStatus
  changed_by String
  changedBy  User        @relation(fields: [changed_by], references: [id])
  changed_at DateTime    @default(now())
}

model LostReason {
  id          String @id @default(uuid())
  reason_text String
  leads       Lead[]
}

model Customer {
  id                 String   @id @default(uuid())
  phone              String   @unique
  name               String?
  is_repeat_customer Boolean  @default(false)
  tags               String[]

  leads      Lead[]
  bookings   Booking[]
  Payment    Payment[]
  Complaints Complaint[]
  Quotes     Quote[]
}

enum BookingStatus {
  Draft
  Pending
  Confirmed
  Scheduled
  Assigned
  InProgress
  Completed
  Cancelled
  NoShow
}

model Booking {
  id         String @id @default(uuid())
  booking_id String @unique

  lead_id         String?      @unique
  lead            Lead?        @relation(fields: [lead_id], references: [id])
  customer_id     String
  customer        Customer     @relation(fields: [customer_id], references: [id])
  city_id         String
  city            City         @relation(fields: [city_id], references: [id])
  service_id      String
  service         Service      @relation(fields: [service_id], references: [id])
  pricing_rule_id String?
  pricingRule     PricingRule? @relation(fields: [pricing_rule_id], references: [id])

  scheduled_date DateTime
  slot           String?

  customer_name  String?
  customer_phone String
  customer_email String?

  address_line_1 String
  address_line_2 String?
  area           String?
  landmark       String?
  city_name      String
  postal_code    String
  state          String
  country        String  @default("India")
  latitude       Float?
  longitude      Float?

  service_name               String
  estimated_duration_minutes Int?

  base_price            Decimal @db.Decimal(10, 2)
  discount              Decimal @default(0) @db.Decimal(10, 2)
  tax                   Decimal @default(0) @db.Decimal(10, 2) // Retained for backward compatibility/total tax
  cgst_percent          Decimal @default(0) @db.Decimal(5, 2)
  cgst_amount           Decimal @default(0) @db.Decimal(10, 2)
  sgst_percent          Decimal @default(0) @db.Decimal(5, 2)
  sgst_amount           Decimal @default(0) @db.Decimal(10, 2)
  igst_percent          Decimal @default(0) @db.Decimal(5, 2)
  igst_amount           Decimal @default(0) @db.Decimal(10, 2)
  final_amount          Decimal @db.Decimal(10, 2)
  pricing_snapshot_json Json?
  pricing_rule_name     String?
  pricing_version       String?

  status BookingStatus @default(Pending)

  notes                String?
  special_instructions String?
  cancel_reason        String?

  assigned_user_id String?
  assignedUser     User?   @relation("AssignedBookings", fields: [assigned_user_id], references: [id])

  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  confirmed_at DateTime?
  scheduled_at DateTime?
  assigned_at  DateTime?
  started_at   DateTime?
  completed_at DateTime?
  cancelled_at DateTime?

  history BookingHistory[]
  job     Job?
  Complaints Complaint[]

  @@index([booking_id])
  @@index([status])
  @@index([scheduled_date])
  @@index([customer_id])
  @@index([city_id])
  @@index([service_id])
  @@index([assigned_user_id])
  @@index([created_at])
}

model BookingHistory {
  id          String         @id @default(uuid())
  booking_id  String
  booking     Booking        @relation(fields: [booking_id], references: [id])
  from_status BookingStatus?
  to_status   BookingStatus
  changed_by  String
  changed_at  DateTime       @default(now())
}

model BookingSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model JobSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

enum JobPriority {
  Low
  Normal
  High
  Urgent
}

enum JobStatus {
  Pending
  Assigned
  Accepted
  Travelling
  Arrived
  Started
  Completed
  Cancelled
  Failed
  NoAccess
  CustomerNotAvailable
  Rescheduled
}

enum JobFailureReason {
  NO_ACCESS
  CUSTOMER_ABSENT
  MATERIAL_MISSING
  WEATHER
  TECHNICAL_FAILURE
  OTHER
}

enum MediaType {
  Image
  Video
  Document
}

enum MediaCategory {
  Before
  After
  Inspection
  Other
}

model Job {
  id         String  @id @default(uuid())
  job_id     String  @unique
  booking_id String  @unique
  booking    Booking @relation(fields: [booking_id], references: [id])

  assigned_user_id String?
  assignedUser     User?   @relation("AssignedJobs", fields: [assigned_user_id], references: [id])

  status   JobStatus   @default(Pending)
  priority JobPriority @default(Normal)

  scheduled_start            DateTime
  scheduled_end              DateTime?
  actual_start               DateTime?
  actual_end                 DateTime?
  estimated_duration_minutes Int?

  completion_notes    String?
  internal_notes      String?
  cancellation_reason String?
  failure_reason      JobFailureReason?

  signature_url  String?
  signed_by_name String?
  signed_at      DateTime?

  latitude  Float?
  longitude Float?

  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  history            JobHistory[]
  assignment_history JobAssignmentHistory[]
  media              JobMedia[]
  Complaints         Complaint[]

  @@index([job_id])
  @@index([status])
  @@index([assigned_user_id])
  @@index([scheduled_start])
}

model JobMedia {
  id          String        @id @default(uuid())
  job_id      String
  job         Job           @relation(fields: [job_id], references: [id], onDelete: Cascade)
  type        MediaType     @default(Image)
  category    MediaCategory @default(Other)
  url         String
  uploaded_by String
  uploaded_at DateTime      @default(now())
}

model JobHistory {
  id              String     @id @default(uuid())
  job_id          String
  job             Job        @relation(fields: [job_id], references: [id], onDelete: Cascade)
  from_status     JobStatus?
  to_status       JobStatus
  changed_by      String
  changed_by_role String?
  ip_address      String?
  changed_at      DateTime   @default(now())
  note            String?
}

model JobAssignmentHistory {
  id               String   @id @default(uuid())
  job_id           String
  job              Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  previous_user_id String?
  new_user_id      String?
  assigned_by      String
  assigned_at      DateTime @default(now())
  reason           String?
}

enum InvoiceStatus {
  Draft
  Issued
  Cancelled
}

enum PaymentStatus {
  Unpaid
  Partial
  Paid
}

enum PaymentMethod {
  Cash
  UPI
  BankTransfer
  Card
  Cheque
}

enum PaymentTransactionStatus {
  Pending
  Completed
  Failed
  Voided
}

model InvoiceSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model PaymentSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model Payment {
  id              String @id @default(uuid())
  payment_number  String @unique // e.g. RCPT-2607-0001
  sequence_number Int    @unique

  invoice_id String
  invoice    Invoice @relation(fields: [invoice_id], references: [id])

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])

  amount         Decimal                  @db.Decimal(10, 2)
  payment_method PaymentMethod
  payment_status PaymentTransactionStatus @default(Pending)
  payment_date   DateTime                 @default(now())

  payment_metadata Json?
  notes            String?

  recorded_by String
  user        User   @relation(fields: [recorded_by], references: [id])

  created_at DateTime @default(now())

  history PaymentHistory[]

  @@index([invoice_id])
  @@index([customer_id])
  @@index([payment_date])
  @@index([payment_status])
  @@index([recorded_by])
}

model PaymentHistory {
  id              String   @id @default(uuid())
  payment_id      String
  payment         Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  action          String
  changed_by      String
  changedBy       User     @relation(fields: [changed_by], references: [id])
  changed_by_role String?
  reason          String?
  ip_address      String?
  changed_at      DateTime @default(now())
}

model Invoice {
  id              String @id @default(uuid())
  invoice_number  String @unique
  sequence_number Int    @unique

  booking_id    String  @unique
  city_id       String
  technician_id String?

  issue_date DateTime
  due_date   DateTime

  // Snapshots
  customer_name   String?
  customer_phone  String
  billing_address String
  service_name    String

  // Financials
  base_amount     Decimal @db.Decimal(10, 2)
  discount_amount Decimal @default(0) @db.Decimal(10, 2)

  // Taxes
  cgst_percent Decimal @default(0) @db.Decimal(5, 2)
  cgst_amount  Decimal @default(0) @db.Decimal(10, 2)
  sgst_percent Decimal @default(0) @db.Decimal(5, 2)
  sgst_amount  Decimal @default(0) @db.Decimal(10, 2)
  igst_percent Decimal @default(0) @db.Decimal(5, 2)
  igst_amount  Decimal @default(0) @db.Decimal(10, 2)

  total_tax_amount Decimal @default(0) @db.Decimal(10, 2)
  final_amount     Decimal @db.Decimal(10, 2)

  // Payment Tracking
  payment_status PaymentStatus @default(Unpaid)
  amount_paid    Decimal       @default(0) @db.Decimal(10, 2)
  balance_due    Decimal       @db.Decimal(10, 2) // Typically initialized with final_amount

  pricing_snapshot_json Json?

  status InvoiceStatus @default(Draft)

  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items    InvoiceItem[]
  history  InvoiceHistory[]
  payments Payment[]
  Complaints Complaint[]

  @@index([status])
  @@index([payment_status])
  @@index([customer_phone])
  @@index([city_id])
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoice_id String
  invoice    Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  service_name    String
  quantity        Int     @default(1)
  unit_price      Decimal @db.Decimal(10, 2)
  discount_amount Decimal @default(0) @db.Decimal(10, 2)

  cgst_amount Decimal @default(0) @db.Decimal(10, 2)
  sgst_amount Decimal @default(0) @db.Decimal(10, 2)
  igst_amount Decimal @default(0) @db.Decimal(10, 2)

  line_total Decimal @db.Decimal(10, 2)
}

model InvoiceHistory {
  id         String  @id @default(uuid())
  invoice_id String
  invoice    Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  action      String
  from_status InvoiceStatus?
  to_status   InvoiceStatus

  changed_by      String
  changed_by_role String?

  reason     String?
  changed_at DateTime @default(now())
}

// ----------------------------------------------------------------------
// PHASE 9: AUTOMATION & TRIGGERS
// ----------------------------------------------------------------------

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

// Generic status for automation executions (e.g., execution log entries)
enum AutomationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum FailureClassification {
  PERMANENT
  TRANSIENT
  VALIDATION
  PROVIDER
  INTERNAL
}

// Explicit, dedicated status lifecycle for notifications
// Distinct from AutomationStatus so the two concerns are never conflated
enum NotificationStatus {
  PENDING      // Queued, not yet picked up
  PROCESSING   // A worker has claimed it
  SENT         // Delivery confirmed by provider
  FAILED       // Max attempts exceeded, manual review needed
  CANCELLED    // Superseded (e.g., booking was cancelled)
}

model ScheduledTask {
  id               String       @id @default(uuid())
  correlation_id   String?      // Traceability across systems
  task_name        String       // e.g., "BOOKING_REMINDER_24H"
  
  // Removed reference_id / reference_type in favor of extensible metadata
  metadata         Json         // Extensible context (e.g., { booking_id: "...", city_id: "..." })
  payload          Json?        // Any data needed for execution

  // idempotency_key prevents duplicate tasks for the same event+action
  // e.g., "BOOKING_REMINDER_24H:BOOK-1234"
  idempotency_key  String       @unique

  scheduled_for    DateTime
  priority         TaskPriority @default(NORMAL)

  // Locking & Execution (multi-worker safety)
  locked_at        DateTime?
  locked_by        String?      // Worker ID (e.g., "worker-PID-RAND")
  attempts         Int          @default(0)
  max_attempts     Int          @default(3)
  last_error       String?

  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  @@index([scheduled_for])
  @@index([locked_at])
  @@index([priority])
  @@index([task_name])
  @@index([correlation_id])
}

model NotificationQueue {
  id                  String             @id @default(uuid())
  correlation_id      String?            // Traceability from trigger -> delivery
  recipient_type      String             // e.g., "Customer", "Staff"
  recipient_id        String
  channel             NotificationChannel
  provider            String?            // e.g., "Twilio", "Meta", "Gupshup"
  provider_message_id String?            // Filled by Phase 10 provider integration
  template_code       String
  payload_version     String             @default("1.0") // Evolving templates
  payload             Json               // Variables for the template renderer
  
  // Explicit lifecycle status - never a boolean
  status              NotificationStatus @default(PENDING)
  error_message       String?
  attempts            Int                @default(0)
  max_attempts        Int                @default(3)

  created_at          DateTime           @default(now())
  sent_at             DateTime?

  @@index([status])
  @@index([recipient_id])
  @@index([correlation_id])
}

model AutomationExecutionLog {
  id            String           @id @default(uuid())
  correlation_id String?         // Traceability across logs
  event_name    String           // e.g., "Booking.Created"
  reference_id  String           // e.g., "BOOK-1234"
  action_taken  String           // e.g., "Queued WhatsApp Message"

  status        AutomationStatus
  error_message String?
  failure_class FailureClassification?

  // Timing for performance diagnostics
  started_at    DateTime
  finished_at   DateTime
  duration_ms   Int

  // Observability fields (invaluable during multi-instance debugging)
  hostname      String           // Server hostname
  worker_id     String           // Worker/process ID
  retry_number  Int              @default(0) // Which attempt this log entry represents

  @@index([event_name, reference_id])
  @@index([status])
  @@index([worker_id])
  @@index([correlation_id])
}

model AutomationMetric {
  id         String   @id @default(uuid())
  metric_key String   @unique // e.g., "Tasks.Scheduled", "Notifications.Sent"
  value      Int      @default(0)
  updated_at DateTime @updatedAt
}

// ----------------------------------------------------------------------
// PHASE 11: OPTIONAL MODULES (Sprint 11.1: Complaint Management)
// ----------------------------------------------------------------------

enum ComplaintStatus {
  Open
  Assigned
  InProgress
  Resolved
  Closed
  Escalated
}

enum ComplaintPriority {
  Low
  Normal
  High
  Critical
}

model ComplaintSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model Complaint {
  id              String           @id @default(uuid())
  complaint_id    String           @unique   // e.g. CMP-2607-001
  sequence_number Int              @unique

  customer_id     String
  customer        Customer         @relation(fields: [customer_id], references: [id])
  
  booking_id      String?          // Optional reference
  booking         Booking?         @relation(fields: [booking_id], references: [id])
  
  job_id          String?          // Optional reference
  job             Job?             @relation(fields: [job_id], references: [id])
  
  invoice_id      String?          // Optional reference
  invoice         Invoice?         @relation(fields: [invoice_id], references: [id])
  
  subject         String
  description     String
  
  status          ComplaintStatus  @default(Open)
  priority        ComplaintPriority @default(Normal)
  
  assigned_to     String?
  assignedTo      User?            @relation("AssignedComplaints", fields: [assigned_to], references: [id])
  
  resolution_note String?
  created_by      String
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  
  timeline        ComplaintTimeline[]
  
  @@index([customer_id])
  @@index([status])
  @@index([assigned_to])
  @@index([booking_id])
}

model ComplaintTimeline {
  id            String          @id @default(uuid())
  complaint_id  String
  complaint     Complaint       @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
  from_status   ComplaintStatus?
  to_status     ComplaintStatus
  note          String?
  changed_by    String
  changed_at    DateTime        @default(now())
}


// ----------------------------------------------------------------------
// PHASE 11: OPTIONAL MODULES (Sprint 11.2: Quote Management)
// NOTE: Approval workflow (auto-booking vs manual) is intentionally
//       NOT implemented here. It will be added once the client confirms
//       the desired behavior. The scaffold is complete in all other respects.
// ----------------------------------------------------------------------

enum QuoteStatus {
  Draft
  Sent
  Viewed
  Accepted
  // Approved → PENDING CLIENT DECISION on booking conversion behavior
  Rejected
  Expired
}

model QuoteSequence {
  id    Int @id @default(1)
  value Int @default(1)
}

model Quote {
  id              String      @id @default(uuid())
  quote_id        String      @unique   // e.g. QT-2607-001
  sequence_number Int         @unique

  // Ownership — always linked to a Customer
  customer_id     String
  customer        Customer    @relation(fields: [customer_id], references: [id])

  // Optional upstream reference — not required
  lead_id         String?
  lead            Lead?       @relation(fields: [lead_id], references: [id])

  // Core fields
  subject         String
  description     String?
  status          QuoteStatus @default(Draft)

  // Pricing totals (computed from line items — stored for PDF/reporting)
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal     @default(0) @db.Decimal(12, 2)
  discount_amount Decimal     @default(0) @db.Decimal(12, 2)
  total_amount    Decimal     @default(0) @db.Decimal(12, 2)

  // PDF / communication
  valid_until     DateTime?
  notes           String?     // Internal notes
  terms           String?     // Customer-facing terms

  // Audit
  created_by      String
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  sent_at         DateTime?
  viewed_at       DateTime?
  accepted_at     DateTime?
  rejected_at     DateTime?

  line_items      QuoteLineItem[]
  timeline        QuoteTimeline[]

  @@index([customer_id])
  @@index([status])
  @@index([lead_id])
  @@index([valid_until])
}

model QuoteLineItem {
  id          String   @id @default(uuid())
  quote_id    String
  quote       Quote    @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  // Optional service reference — not required
  service_id  String?

  description String
  quantity    Int      @default(1)
  unit_price  Decimal  @db.Decimal(12, 2)
  tax_percent Decimal  @default(18) @db.Decimal(5, 2)
  total_price Decimal  @db.Decimal(12, 2)

  sort_order  Int      @default(0)

  @@index([quote_id])
}

model QuoteTimeline {
  id          String      @id @default(uuid())
  quote_id    String
  quote       Quote       @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  from_status QuoteStatus?
  to_status   QuoteStatus
  note        String?
  changed_by  String
  changed_at  DateTime    @default(now())

  @@index([quote_id])
}
