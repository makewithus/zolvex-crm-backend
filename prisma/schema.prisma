generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model City {
  id           String        @id @default(uuid())
  name         String        @unique
  is_active    Boolean       @default(true)
  users        User[]
  serviceAreas ServiceArea[]
  pricingRules PricingRule[]
  leads        Lead[]
}

model ServiceArea {
  id             String  @id @default(uuid())
  city_id        String
  city           City    @relation(fields: [city_id], references: [id])
  name           String
  polygon_coords Json
  is_active      Boolean @default(true)
}

model User {
  id                String              @id @default(uuid())
  name              String
  phone             String              @unique
  password_hash     String
  role_id           String
  role              Role                @relation(fields: [role_id], references: [id])
  city_id           String?
  city              City?               @relation(fields: [city_id], references: [id])
  joining_date      DateTime?
  is_active         Boolean             @default(true)
  skill_tags        String[]
  staffAvailability StaffAvailability[]
  assignedLeads     Lead[]
  leadNotes         LeadNote[]
  leadHistory       LeadHistory[]
}

model StaffAvailability {
  id              String   @id @default(uuid())
  staff_id        String
  staff           User     @relation(fields: [staff_id], references: [id])
  date            DateTime
  is_available    Boolean  @default(true)
  daily_job_limit Int?
  jobs_assigned   Int      @default(0)
}

model Service {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  base_price   Float
  is_active    Boolean       @default(true)
  pricingRules PricingRule[]
  leads        Lead[]
}

model PricingRule {
  id         String  @id @default(uuid())
  service_id String
  service    Service @relation(fields: [service_id], references: [id])
  city_id    String?
  city       City?   @relation(fields: [city_id], references: [id])
  bhk_type   String?
  tank_size  String?
  base_price Float

  @@unique([service_id, city_id, bhk_type, tank_size])
}

enum LeadStatus {
  New
  Contacted
  FollowUp
  Qualified
  QuotationSent
  Booked
  Lost
}

enum LeadSource {
  Phone
  WhatsApp
  WebsiteForm
  MetaAds
  ManualEntry
  Justdial
  Referrals
}

model Lead {
  id          String   @id @default(uuid())
  phone       String
  name        String?
  source      LeadSource
  status      LeadStatus @default(New)
  city_id     String?
  city        City?    @relation(fields: [city_id], references: [id])
  service_id  String?
  service     Service? @relation(fields: [service_id], references: [id])
  assigned_to String?
  assignedTo  User?    @relation(fields: [assigned_to], references: [id])
  lost_reason_id String?
  lostReason  LostReason? @relation(fields: [lost_reason_id], references: [id])
  customer_id String
  customer    Customer   @relation(fields: [customer_id], references: [id])

  notes       LeadNote[]
  history     LeadHistory[]
}

model LeadNote {
  id         String   @id @default(uuid())
  lead_id    String
  lead       Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  note_text  String
  created_by String
  createdBy  User     @relation(fields: [created_by], references: [id])
  created_at DateTime @default(now())
}

model LeadHistory {
  id         String   @id @default(uuid())
  lead_id    String
  lead       Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  from_stage LeadStatus?
  to_stage   LeadStatus
  changed_by String
  changedBy  User     @relation(fields: [changed_by], references: [id])
  changed_at DateTime @default(now())
}

model LostReason {
  id          String   @id @default(uuid())
  reason_text String
  leads       Lead[]
}

model Customer {
  id                 String   @id @default(uuid())
  phone              String   @unique
  name               String?
  is_repeat_customer Boolean  @default(false)
  tags               String[]
  
  leads              Lead[]
}
